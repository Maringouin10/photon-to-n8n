# --- Ports ---
# Local-only port n8n calls to ask the bridge to SEND an iMessage.
SEND_PORT=8105
# Public-facing port that Photon calls to deliver INCOMING iMessages.
WEBHOOK_PORT=8106

# --- n8n side ---
# Where the bridge forwards every inbound iMessage it receives from Photon.
N8N_WEBHOOK_URL=https://n8n1.voituredujour.duckdns.org/webhook/photon

# Optional shared secret n8n must send back to the bridge on /send
# (header: x-bridge-token). Leave empty while everything is local-only.
SEND_AUTH_TOKEN=

# --- Photon side ---
# From app.photon.codes -> your project -> Settings.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=

# Full URL of Photon's "send message" REST endpoint. Confirm the exact path
# against docs.photon.codes (Spectrum API) for your account/plan, then set it
# here verbatim - the code does not hardcode it.
PHOTON_SEND_URL=https://api.photon.codes/v1/messages/send

# How PHOTON_API_KEY is sent to Photon. Defaults match a typical
# "Authorization: Bearer <key>" scheme; adjust if Photon's docs say otherwise.
PHOTON_AUTH_HEADER=Authorization
PHOTON_AUTH_SCHEME=Bearer

# Optional: if Photon signs webhook bodies (HMAC), paste the signing secret
# from your Photon project settings here to enable verification.
# Leave empty to disable signature checking.
PHOTON_WEBHOOK_SECRET=
# Name of the header Photon puts the signature in. Confirm against the docs;
# this is a configurable guess, not a confirmed default.
PHOTON_SIGNATURE_HEADER=x-photon-signature
