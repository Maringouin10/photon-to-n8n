# --- n8n side ---
# Local port n8n calls to ask the bridge to SEND an iMessage.
SEND_PORT=8105

# Where the bridge forwards every inbound iMessage it receives from Photon.
N8N_WEBHOOK_URL=https://n8n1.voituredujour.duckdns.org/webhook/photon

# Optional shared secret n8n must send back to the bridge on /send
# (header: x-bridge-token). Recommended once other things share the network.
SEND_AUTH_TOKEN=

# --- Photon side ---
# From app.photon.codes -> your project -> Settings ("Project ID" and
# "Secret Key"/API key).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Advanced/rarely needed overrides - leave empty to use Photon's defaults
# (confirmed from the @spectrum-ts/imessage published source):
#   control plane : https://spectrum.photon.codes
#   shared gRPC   : imessage.spectrum.photon.codes:443
# SPECTRUM_CLOUD_URL=
# PHOTON_IMESSAGE_ADDRESS=
